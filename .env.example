# ---------------------------------------------------------------------------
# Toolkit Bot configuration. Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Telegram bot token from @BotFather (required)
BOT_TOKEN=123456:your_bot_token_here

# Public HTTPS base URL where this service is reachable, no trailing slash.
# This is the domain you point at your Oracle VM (Caddy terminates TLS here).
# Example: https://toolkit.example.com
PUBLIC_URL=https://toolkit.example.com

# Local address the Python service binds to. Caddy reverse-proxies to this.
# Leave as-is unless you changed the Caddyfile.
HOST=127.0.0.1
PORT=8080

# Random secret used in the webhook path so only Telegram can reach it.
# Generate once with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=change_me_to_a_long_random_string

# --- Optional integrations (features disable cleanly if unset) ---

# Have I Been Pwned API key (https://haveibeenpwned.com/API/Key).
# Without it, the breach checker reports "not configured" instead of guessing.
HIBP_API_KEY=

# --- AI text detector (all optional; the built-in heuristic works without keys) ---
# Hugging Face access token (FREE): https://huggingface.co/settings/tokens
# Enables the Hugging Face detector models (two real detectors for free).
HF_TOKEN=
# Sapling AI-detector API key (free tier): https://sapling.ai/
SAPLING_API_KEY=

# Set to "polling" to run without a public URL (local dev / testing).
# Set to "webhook" (default) for the Oracle VM production deployment.
RUN_MODE=webhook
